{
  "name": "falcon0x1-portfolio",
  "version": "1.0.0",
  "description": "Mahmoud Elshorbagy (falcon0x1) - security engineer portfolio",
  "scripts": {
    "prebuild": "mkdir -p dist",
    "build:images": "node scripts/build-images.js",
    "build:css": "npx tailwindcss -i css/tailwind-input.css -o dist/output.css --minify && node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "build:html": "node scripts/build-html.js",
    "build": "npm run prebuild && npm run build:images && npm run build:css && npm run build:js && npm run build:html",
    "predev": "npm run build",
    "dev": "npx serve dist -l 3000",
    "dev:dist": "npx serve dist -l 3000"
  },
  "devDependencies": {
    "cssnano": "^6.0.0",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.4.0",
    "postcss-import": "^15.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "terser": "^5.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "private": true
}
